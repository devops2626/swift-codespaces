{
  "name": "Swift",
  "image": "swift:latest",
  "customizations": {
    "vscode": {
      "extensions": [
        "swiftlang.swift-vscode"
      ],
      "settings": {
        "lldb.library": "/usr/lib/liblldb.so"
      }
    }
  },
  "runArgs": [
    "--cap-add=SYS_PTRACE",
    "--security-opt",
    "seccomp=unconfined"
  ],
  "postCreateCommand": "swift --version"
}
